<Window x:Class="PR1_Kamil_IS141.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR1_Kamil_IS141"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="400" ResizeMode="NoResize">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="0.6*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="User Profile" FontSize="16" Grid.ColumnSpan="4" FontWeight="Bold" HorizontalAlignment="Center" Style="{StaticResource Capriontext}"/>
        <Label Content="Name:" Grid.Column="1" Grid.Row="1" FontSize="15" HorizontalAlignment="Right"/>
        <Label Content="Email:" Grid.Column="1" Grid.Row="2" FontSize="15" HorizontalAlignment="Right"/>
        <Label Content="Bio:" Grid.Column="1" Grid.Row="3" FontSize="15" HorizontalAlignment="Right"/>
        <Button Content="Save Profile" Grid.ColumnSpan="4"  Grid.Row="4" Width="200" Height="45" HorizontalAlignment="Center" Style="{StaticResource ButtonPrimary}"/>
        <TextBox Text="John Doe" Grid.Column="2" Grid.Row="1" Margin="0 5 0 25" FontSize="15" HorizontalAlignment="Stretch"/>
        <TextBox Text="john.doe@example.com" Grid.Column="2" Grid.Row="2" Margin="0 5 0 25" FontSize="15" HorizontalAlignment="Stretch"/>
        <TextBox AcceptsReturn="True" Grid.Column="2" Grid.Row="3" Margin="0 5 0 25" FontSize="15" HorizontalAlignment="Stretch"/>
        <Button Content="exit" Grid.Column="4"  Grid.Row="4" Width="50" Height="45" Style="{StaticResource ButtonWarning}"/>
    </Grid>
</Window>
